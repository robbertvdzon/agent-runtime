# Never commit secrets.env. Generate independent service, worker and admin tokens.
AR_PRODUCT_FACTORY_TOKEN=
AR_SOFTWARE_FACTORY_TOKEN=
AR_WORKER_TOKEN=
AR_ADMIN_TOKEN=
AR_GOOGLE_CLIENT_ID=
AR_ADMIN_EMAILS=
AR_SESSION_SIGNING_SECRET=
AR_DB_USERNAME=agent_runtime
AR_DB_PASSWORD=
AR_DB_URL=jdbc:postgresql://agent-runtime-postgresql:5432/agent_runtime

# Local worker only; these directories are mounted read-only as credential sources.
AR_CODEX_CREDENTIALS_DIR=
AR_CLAUDE_CREDENTIALS_DIR=
