# Copy this file to properties.env on a worker laptop and run: chmod 600 properties.env
AR_SERVER_URL=https://agent-runtime.vdzonsoftware.nl
AR_WORKER_ID=voornaam-macbook
AR_WORK_ROOT=work/worker
AR_WORKER_TOKEN=

# Configure at least one provider with an absolute path. Do not use ~ or $HOME.
AR_CODEX_CREDENTIALS_DIR=/Users/account/.codex

# Preferred Claude subscription authentication. Generate it with: claude setup-token
AR_CLAUDE_OAUTH_TOKEN=

# Fallback for systems where Claude credentials are stored in files instead of a keychain.
# AR_CLAUDE_CREDENTIALS_DIR=/Users/account/.claude

# Required for each offered provider: comma-separated exact model names this worker can execute.
# These capabilities participate in v2 job matching; the Runtime never chooses a fallback model.
# AR_CODEX_MODELS=gpt-5.6-sol
# AR_CLAUDE_MODELS=claude-sonnet-5,claude-opus-5

# Repositoryaliases available to v2 jobs. Configure each Software Factory-managed repository on
# the production worker. URLs and credentials remain local to this owner-only file and are never
# returned by the Runtime API or mounted into the agentcontainer.
# AR_REPOSITORY_SOFTWARE_FACTORY_URL=https://github.com/example/software-factory.git
# AR_REPOSITORY_AGENT_RUNTIME_URL=https://github.com/example/agent-runtime.git
# AR_REPOSITORY_PVDD_URL=https://github.com/example/pvdd.git
# AR_REPOSITORY_HKH_AUTOPILOT_URL=https://github.com/example/hkh-autopilot.git
# AR_REPOSITORY_PRODUCT_FACTORY_URL=https://github.com/example/product-factory.git
# AR_REPOSITORY_PERSONAL_NEWS_FEED_URL=https://github.com/example/personal-news-feed.git
# AR_REPOSITORY_ROBBERTS_ASSISTENT_URL=https://github.com/example/robberts-assistent.git

# Parallel slots per job class (defaults 6/2/1). Short application jobs never wait behind repository jobs.
# AR_WORKER_APPLICATION_SLOTS=6
# AR_WORKER_REPOSITORY_SLOTS=2
# AR_WORKER_TRANSCRIPTION_SLOTS=1

# LOCAL transcription with whisper.cpp on the macOS host (brew install whisper-cpp ffmpeg).
# Comma-separated modelName=absolute-path pairs; advertised only when binary, ffmpeg and model exist.
# AR_WHISPER_MODELS=large-v3-turbo=/Users/account/.cache/whisper/ggml-large-v3-turbo.bin
# AR_WHISPER_BINARY=/opt/homebrew/bin/whisper-cli
# AR_FFMPEG_BINARY=/opt/homebrew/bin/ffmpeg
# AR_WHISPER_THREADS=8
