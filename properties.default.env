# Non-secret local worker defaults. The owner-only properties.env overrides these values.
AR_SERVER_URL=http://localhost:8080
AR_WORKER_ID=local-macbook
AR_WORK_ROOT=work/worker
AR_EXECUTION_IMAGE=ghcr.io/robbertvdzon/agent-runtime-execution:main
AR_REPOSITORY_AGENT_RUNTIME_URL=https://github.com/robbertvdzon/agent-runtime.git
AR_REPOSITORY_SOFTWARE_FACTORY_URL=https://github.com/robbertvdzon/software-factory.git
